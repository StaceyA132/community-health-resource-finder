# Supabase (optional; without these the app serves the sample data in data/resources.ts)
SUPABASE_URL=https://your-project.supabase.co
# Prefer the anon key with a Row Level Security policy; see README.
SUPABASE_ANON_KEY=your-anon-key

# AI chat replies (optional; without a key the helper uses local keyword matching)
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-5
